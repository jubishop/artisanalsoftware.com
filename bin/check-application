#!/usr/bin/env python3
"""Run artisanalsoftware.com's application checks; bin/check --full calls this after the foundation checks."""

from pathlib import Path
import subprocess
import sys

ROOT = Path(__file__).resolve().parents[1]


def main():
    result = subprocess.run([sys.executable, "-B", "-m", "unittest", "discover", "-s", "tests", "-p", "test_*.py", "-v"],
                            cwd=ROOT).returncode
    if result:
        return result
    # The npm pretest hook rejects unsupported Node versions before Mocha starts.
    try:
        return subprocess.run(["npm", "test"], cwd=ROOT).returncode
    except OSError as error:
        print(f"Cannot run application checks: {error}. Select Node 24 and run npm ci.", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
