<%- include('../partials/head') %>
<body class="ph-body">
<%- include('../partials/nav') %>
<main id="main" class="ph-container">
  <header class="ph-page-header">
    <p class="ph-eyebrow">The PodHaven guide</p>
    <h1>Find your way.<br>Make it your own.</h1>
    <p class="ph-lead">A little guidance for your next listen. Get more from on-device recommendations, build useful Smart Lists and filters, and tune the settings to fit your life.</p>
  </header>
  <a class="ph-guide-start" href="/podhaven/guides/getting-started"><div><span class="ph-eyebrow">New here? Start with this.</span><h2>Your first good listen.</h2><p>Add your shows, set your pace, and meet the parts that make PodHaven personal.</p></div><span aria-hidden="true">↗</span></a>
  <section class="ph-guide-grid" aria-label="Guides by topic">
    <% for (const [key, guide] of Object.entries(guides)) { if (key === 'getting-started') continue; %>
      <a href="/podhaven/guides/<%= key %>" class="ph-guide-card"><span class="ph-eyebrow"><%= guide.label %></span><h2><%= guide.title %></h2><p><%= guide.description %></p><span class="ph-card-arrow" aria-hidden="true">↗</span></a>
    <% } %>
  </section>
  <section class="ph-guide-bottom"><p class="ph-eyebrow">A useful place to return to</p><h2>Looking for one particular control?</h2><p>The settings reference covers the everyday options, and the per-podcast guide explains how to give each show its own routine.</p><div class="ph-actions"><a class="ph-button" href="/podhaven/guides/settings">Settings reference</a><a class="ph-text-link" href="/podhaven/guides/per-podcast-settings">Per-podcast settings <span aria-hidden="true">↗</span></a></div></section>
</main>
<%- include('../partials/footer') %>
