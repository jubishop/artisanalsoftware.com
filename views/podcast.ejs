<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <!-- Page Title -->
  <title><%= podcast.title %></title>

  <!-- SEO Meta Tags -->
  <meta name="description" content="<%= podcast.description.replace(/<[^>]*>/g, '').substring(0, 160) %>">
  <meta name="author" content="<%= podcast.author %>">

  <!-- Favicon -->
  <% if (podcast.imageUrl) { %>
  <link rel="icon" href="<%= podcast.imageUrl %>" type="image/x-icon">
  <link rel="apple-touch-icon" href="<%= podcast.imageUrl %>">
  <% } %>

  <!-- Open Graph Meta Tags -->
  <meta property="og:title" content="<%= podcast.title %>">
  <meta property="og:description" content="<%= podcast.description.replace(/<[^>]*>/g, '').substring(0, 200) %>">
  <% if (podcast.imageUrl) { %>
  <meta property="og:image" content="<%= podcast.imageUrl %>">
  <% } %>
  <meta property="og:url" content="<%= podcastWebUrl %>">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="PodHaven">

  <!-- Twitter Card Meta Tags -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= podcast.title %>">
  <meta name="twitter:description" content="<%= podcast.description.replace(/<[^>]*>/g, '').substring(0, 200) %>">
  <% if (podcast.imageUrl) { %>
  <meta name="twitter:image" content="<%= podcast.imageUrl %>">
  <% } %>

  <!-- CSS -->
  <link rel="stylesheet" href="/public/css/styles.css">
</head>
<body>
  <div class="container">
    <div class="podcast-header">
      <% if (podcast.imageUrl) { %>
      <img src="<%= podcast.imageUrl %>" alt="<%= podcast.title %>" class="podcast-image">
      <% } %>

      <div class="podcast-info">
        <h1 class="podcast-title"><%= podcast.title %></h1>
        <p class="podcast-author">By <%= podcast.author %></p>

        <% if (podcast.descriptionHtml) { %>
        <div class="podcast-description"><%- podcast.descriptionHtml %></div>
        <% } else { %>
        <p class="podcast-description"><%= podcast.description %></p>
        <% } %>

        <div class="podcast-links">
          <% if (podcast.link) { %>
          <a href="<%= podcast.link %>" class="btn btn-secondary" target="_blank">Visit Website</a>
          <% } %>
          <a href="<%= podcastShareLink %>" class="btn btn-primary">Open in PodHaven</a>
        </div>
      </div>
    </div>

    <div class="episodes-section">
      <h2>Episodes</h2>
      <div class="episodes-list">
        <% episodes.forEach(episode => { %>
        <div class="episode-item">
          <div class="episode-content">
            <h3 class="episode-title">
              <a href="<%= episode.webUrl %>"><%= episode.title %></a>
            </h3>
            <p class="episode-date"><%= new Date(episode.pubDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></p>
            <% if (episode.duration) { %>
            <p class="episode-duration">Duration: <%= episode.duration %></p>
            <% } %>
          </div>
          <div class="episode-actions">
            <a href="<%= episode.shareLink %>" class="btn btn-small">Open in PodHaven</a>
          </div>
        </div>
        <% }); %>
      </div>
    </div>
  </div>
</body>
</html>
