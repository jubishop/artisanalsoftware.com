<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <!-- Page Title -->
  <title><%= episode.title %><%= startTimeFormatted ? ' @ ' + startTimeFormatted : '' %> - <%= podcast.title %></title>

  <!-- SEO Meta Tags -->
  <meta name="description" content="<%= metaDescription %>">
  <meta name="author" content="<%= podcast.title %>">

  <!-- Favicon -->
  <% if (episodeImage) { %>
  <link rel="icon" href="<%= episodeImage %>" type="image/x-icon">
  <link rel="apple-touch-icon" href="<%= episodeImage %>">
  <% } %>

  <!-- Open Graph Meta Tags -->
  <meta property="og:title" content="<%= episode.title %><%= startTimeFormatted ? ' @ ' + startTimeFormatted : '' %>">
  <meta property="og:description" content="<%= ogDescription %>">
  <% if (episodeImage) { %>
  <meta property="og:image" content="<%= episodeImage %>">
  <% } %>
  <meta property="og:url" content="<%= episodeWebUrl %>">
  <meta property="og:type" content="article">
  <meta property="og:site_name" content="PodHaven">
  <% if (episode.audioUrl) { %>
  <meta property="og:audio" content="<%= episode.audioUrl %>">
  <% } %>

  <!-- Twitter Card Meta Tags -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= episode.title %><%= startTimeFormatted ? ' @ ' + startTimeFormatted : '' %>">
  <meta name="twitter:description" content="<%= ogDescription %>">
  <% if (episodeImage) { %>
  <meta name="twitter:image" content="<%= episodeImage %>">
  <% } %>

  <!-- CSS -->
  <link rel="stylesheet" href="<%= assetUrl('/public/css/styles.css') %>">
</head>
<body>
  <div class="container">
    <div class="episode-header">
      <% if (episodeImage) { %>
      <img src="<%= episodeImage %>" alt="<%= episode.title %>" class="episode-image">
      <% } %>

      <div class="episode-info">
        <h1 class="episode-title"><%= episode.title %></h1>

        <p class="episode-podcast">
          From <a href="<%= podcastPageUrl %>"><%= podcast.title %></a>
        </p>

        <div class="episode-meta">
          <p class="episode-date">
            <%= new Date(episode.pubDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %>
          </p>
          <% if (episode.duration) { %>
          <p class="episode-duration">Duration: <%= episode.duration %></p>
          <% } %>
        </div>

        <% if (episode.audioUrl) { %>
        <div class="episode-audio">
          <audio controls>
            <source src="<%= episode.audioUrl %><%= startTime ? '#t=' + startTime : '' %>" type="audio/mpeg">
            Your browser does not support the audio element.
          </audio>
        </div>
        <% } %>

        <div class="episode-links">
          <a href="<%= episodeShareLink %>" class="btn btn-primary">Open in PodHaven</a>
          <a href="<%= podcastPageUrl %>" class="btn btn-secondary">View Podcast</a>
        </div>
      </div>
    </div>

    <div class="episode-description-section">
      <h2>Episode Description</h2>
      <% if (episode.descriptionHtml) { %>
      <div class="episode-description"><%- episode.descriptionHtml %></div>
      <% } else { %>
      <p class="episode-description"><%= episode.description %></p>
      <% } %>
    </div>
  </div>
</body>
</html>
